{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "debug: resume_parser proj-mngr.docx",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/resume_parser.py",
            "console": "integratedTerminal",
            "args": [
                "proj-mngr.docx",
                "proj-mngr-docx.json"
            ]
        },
        {
            "name": "debug: resume_parser proj-mngr.pdf",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/resume_parser.py",
            "console": "integratedTerminal",
            "args": [
                "proj-mngr.pdf",
                "proj-mngr-pdf.json"
            ]
        },
        {
            "name": "debug: unittest tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s", "tests",
                "-v"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}