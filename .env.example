# LLM provider: Anthropic (ANTHROPIC_API_KEY required)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: Anthropic model id (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: force LLM_PROVIDER (e.g. if ANTHROPIC_API_KEY is set but other keys exist in env)
# LLM_PROVIDER=anthropic
