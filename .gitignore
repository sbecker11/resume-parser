# .env is intentionally tracked + git-crypt encrypted (see .gitattributes /
# docs/SECRETS.md) so it round-trips through clone/pull. Do NOT re-add it
# here; ignore local override files instead if you create any.
.env.local
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.coverage
coverage.json
htmlcov/
outputs-*
.DS_Store
resumes/
parsed_resumes/
